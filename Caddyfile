# Full structural analyses take ~10-60 s; allow up to 180 s for the first
# response byte (same budget as the Next.js proxyTimeout).
(backend_proxy) {
	reverse_proxy backend:8000 {
		transport http {
			dial_timeout 5s
			response_header_timeout 180s
		}
	}
}

{$APP_SCHEME:http}://{$APP_DOMAIN:localhost} {
	encode zstd gzip
	log {
		output stdout
		format json
	}

	# Largest legitimate payloads (Geometry 2.3 drafts) stay under 2 MB.
	request_body {
		max_size 10MB
	}

	handle /api/* {
		import backend_proxy
	}

	handle /health {
		import backend_proxy
	}

	handle {
		reverse_proxy frontend:3000
	}
}
