APP_DOMAIN=localhost
# Local Docker uses HTTP so Windows does not need to trust a container certificate.
# Set APP_SCHEME=https only when APP_DOMAIN is a real HTTPS-enabled domain.
APP_SCHEME=http
POSTGRES_DB=steel_compass
POSTGRES_USER=steel_compass
POSTGRES_PASSWORD=replace-with-a-long-random-password
STEEL_COMPASS_BOOTSTRAP_ADMIN_USERNAME=admin
STEEL_COMPASS_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-long-random-password
STEEL_COMPASS_COOKIE_SECURE=false
STEEL_COMPASS_FRONTEND_ORIGIN=http://localhost
